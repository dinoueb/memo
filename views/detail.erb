<article class="memo-area">
  <div class="memo-item">
    <p class="label">タイトル</p>
    <h1 class="memo-title memo-field"><%= h(@memo[:title]) %></h1>
  </div>
  <div class="memo-item">
    <p class="label">内容</p>
    <p class="memo-text memo-field"><%= h(@memo[:text]) %></p>
  </div>
  <div class="buttons">
    <a href="/memos" class="button">一覧へ戻る</a>
    <a href="/memos/<%= h(@memo[:id]) %>/edit" class="button">編集</a>
    <form action="/memos/<%= h(@memo[:id]) %>" method="post">
      <input type="hidden" name="_method" value="DELETE">
      <button type="submit" class="button">削除</button>
    </form>
  </div>
</article>
