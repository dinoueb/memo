<article>
  <h1><%= h(@memo["title"]) %></h1>
  <p><%= h(@memo["text"]) %></p>
  <div>
    <a href="/memos">一覧へ戻る</a>
    <a href="/memos/<%= h(@memo["id"]) %>/edit">編集</a>
    <form action="/memos/<%= h(@memo["id"]) %>" method="post">
      <input type="hidden" name="_method" value="DELETE">
      <button type="submit">削除</button>
    </form>
  </div>
</article>
